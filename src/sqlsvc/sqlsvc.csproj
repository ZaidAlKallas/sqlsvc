<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CA1416</NoWarn>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sqlsvc</ToolCommandName>
    <PackageId>sqlsvc</PackageId>
    <Version>0.4.0</Version>
    <Title>sqlsvc</Title>
    <Description>.NET CLI tool for managing local SQL Server services on Windows. List, start, stop, and configure startup types (auto/manual/disabled) with table, JSON, and CSV output, plus an interactive TUI.</Description>
    <Authors>ZaidAlKallas</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.56.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
